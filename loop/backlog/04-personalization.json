      ],
      "acceptance": [
        "A short questionnaire asks about red-flag symptoms",
        "Red flags route directly to the emergency screen",
        "Non-red-flag results produce a safe summary for the AI",
        "At least eight tests cover routing and edge cases"
      ],
      "checks": [
        { "type": "fileExists", "path": "src/features/triage/symptom-checker.tsx" },
        { "type": "fileExists", "path": "src/features/triage/triage-rules.ts" },
        { "type": "fileExists", "path": "app/triage.tsx" },
        { "type": "fileExists", "path": "__tests__/triage.test.ts" },
        { "type": "minTestCount", "path": "__tests__/triage.test.ts", "min": 8 },
        { "type": "command", "name": "triage-tests", "cmd": "npm test -- --runInBand triage", "timeoutMs": 300000 }
