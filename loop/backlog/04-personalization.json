      ],
      "acceptance": [
        "Users can favorite and unfavorite guides",
        "Favorites appear on Home and in Guides",
        "Recent activity shows the last viewed guides",
        "At least four tests cover favorite, unfavorite, and recents"
      ],
      "checks": [
        { "type": "fileExists", "path": "src/features/guides/favorites.store.ts" },
        { "type": "fileExists", "path": "src/features/guides/components/favorite-button.tsx" },
