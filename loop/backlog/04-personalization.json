      "checks": [
        { "type": "fileExists", "path": "src/services/analytics/analytics.ts" },
        { "type": "fileExists", "path": "__tests__/analytics.test.ts" },
        { "type": "fileContains", "path": "src/features/settings/components/settings-screen.tsx", "pattern": "analytics" },
        { "type": "minTestCount", "path": "__tests__/analytics.test.ts", "min": 4 },
        { "type": "command", "name": "analytics-tests", "cmd": "npm test -- --runInBand analytics", "timeoutMs": 300000 }
