    {
      "id": "P4-06",
      "title": "Phase 4 review",
      "priority": "P1",
      "dependsOn": ["P4-01", "P4-02", "P4-03", "P4-04", "P4-05"],
      "humanGate": true,
      "blocking": true,
      "estimatedMinutes": 30,
      "scope": ["loop/PROGRESS.md", "src/features/profile/**", "src/features/reminders/**"],
      "acceptance": [
        "A human has created a profile, reminder, favorite, and triage run",
        "No health data leaves the device without consent",
