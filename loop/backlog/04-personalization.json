        "app/reminders.tsx",
        "__tests__/reminders.test.ts"
      ],
      "acceptance": [
        "Reminders can be created, edited, enabled, and disabled",
        "Schedules survive app restart",
        "Notification permission denial is handled gracefully",
        "At least six tests cover scheduling, persistence, and permission denial"
      ],
      "checks": [
        { "type": "fileExists", "path": "src/features/reminders/reminders.store.ts" },
        { "type": "fileExists", "path": "src/services/notifications/notifications.ts" },
        { "type": "fileExists", "path": "app/reminders.tsx" },
        { "type": "fileExists", "path": "__tests__/reminders.test.ts" },
        { "type": "minTestCount", "path": "__tests__/reminders.test.ts", "min": 6 },
        { "type": "command", "name": "reminders-tests", "cmd": "npm test -- --runInBand reminders", "timeoutMs": 300000 }
      ]
    },
    {
