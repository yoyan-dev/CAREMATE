{
  "phase": 4,
  "name": "Personalization",
  "goal": "Add local profile, reminders, favorites, structured triage, and consent-based analytics.",
  "tasks": [
    {
      "id": "P4-01",
      "title": "Add a local health profile",
      "priority": "P1",
      "dependsOn": ["P3-07"],
      "humanGate": false,
      "estimatedMinutes": 120,
      "scope": [
        "src/features/profile/profile.store.ts",
        "src/data/repositories/profile.repository.ts",
        "app/profile.tsx",
        "__tests__/profile.test.ts"
      ],
      "acceptance": [
        "Age band, allergies, conditions, and medications are stored locally",
        "Profile data is never sent to AI without explicit consent",
        "Users can edit and delete the profile",
        "At least five tests cover persistence, consent, and deletion"
      ],
      "checks": [
        { "type": "fileExists", "path": "src/features/profile/profile.store.ts" },
        { "type": "fileExists", "path": "src/data/repositories/profile.repository.ts" },
        { "type": "fileExists", "path": "app/profile.tsx" },
        { "type": "fileExists", "path": "__tests__/profile.test.ts" },
        { "type": "minTestCount", "path": "__tests__/profile.test.ts", "min": 5 },
        { "type": "command", "name": "profile-tests", "cmd": "npm test -- --runInBand profile", "timeoutMs": 300000 }
      ]
    },
    {
      "id": "P4-02",
      "title": "Add medication reminders with local notifications",
      "priority": "P1",
      "dependsOn": ["P3-07"],
      "humanGate": false,
      "estimatedMinutes": 150,
      "scope": [
        "src/features/reminders/reminders.store.ts",
